# ==== Copy to .env and fill. .env is gitignored — never commit real secrets. ====

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o

# --- Embeddings (local Ollama) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# --- n8n ---
N8N_PORT=5679
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5679/
GENERIC_TIMEZONE=Asia/Karachi
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32CHARS
# Set during setup (scripts create the owner + API key + credential):
N8N_OWNER_EMAIL=you@example.com
N8N_OWNER_PASSWORD=REPLACE_ME_Strong1
N8N_API_KEY=REPLACE_ME
N8N_PG_CRED_ID=REPLACE_ME

# --- Qdrant ---
QDRANT_PORT=6343
QDRANT_URL=http://dental-qdrant:6333
QDRANT_COLLECTION=clinic_kb

# --- Postgres ---
POSTGRES_PORT=5433
POSTGRES_DB=dental
POSTGRES_USER=dental
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_HOST=dental-postgres

# --- Redis ---
REDIS_PORT=6380
REDIS_HOST=dental-redis

# --- Voice ---
VOICE_BASE_URL=http://localhost:8000
STT_MODEL=whisper-small
TTS_MODEL=kokoro

# --- Ingestion defaults ---
CRAWL_MAX_PAGES=80
CRAWL_MAX_DEPTH=3
CRAWL_USER_AGENT=DentalRAGBot/1.0 (+contact)

# --- Sharing / tunnel ---
TUNNEL_PROVIDER=cloudflared
