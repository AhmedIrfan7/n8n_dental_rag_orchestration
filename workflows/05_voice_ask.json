    {
      "parameters": {
        "jsCode": "// Build the orchestrator request from the transcript (Code node).\n// Input : Transcribe's HTTP response { text, duration }.\n// session_id/website_url come from the ORIGINAL webhook call (multipart\n// form fields), read via named reference since Transcribe sits between.\nconst transcript = $input.first().json;\nconst webhookJson = $('Webhook').first().json;\nconst body = webhookJson.body || {};\n\nconst query = (transcript.text || '').trim();\nif (!query) throw new Error('transcription produced no text');\n\nreturn [{\n  json: {\n    query,\n    session_id: body.session_id || null,\n    website_url: body.website_url,\n  },\n}];\n"
      },
      "id": "d0000000-0000-0000-0000-000000000003",
      "name": "PrepAsk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/ask",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 90000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__WEBHOOK_AUTH_CRED_ID__",
          "name": "Webhook Auth"
        }
      },
      "id": "d0000000-0000-0000-0000-000000000004",
      "name": "AskOrchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Unwrap the orchestrator's response and build the /speak request (Code node).\n// Input : AskOrchestrator's HTTP response - a JSON array (n8n webhook\n// responseData:'allEntries' convention; see route_and_call.js for the\n// same array-unwrap lesson learned in Phase 7).\nlet res = $input.first().json;\nif (Array.isArray(res)) res = res[0] || {};\n\nconst reply = res.reply || \"I'm not sure - please contact the clinic directly.\";\n\nreturn [{\n  json: {\n    reply,\n    session_id: res.session_id,\n    speak_body: { text: reply },\n  },\n}];\n"
      },
      "id": "d0000000-0000-0000-0000-000000000005",
